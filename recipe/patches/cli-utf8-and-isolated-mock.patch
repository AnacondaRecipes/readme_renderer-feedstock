From 7cbb63b058381e375faf86928f678b2b0ddd2414 Mon Sep 17 00:00:00 2001
From: Eric Lundby <elundby@anaconda.com>
Date: Thu, 22 Oct 2026 12:06:13 -0600
Subject: [PATCH] Fix UTF-8 CLI file handling and isolate pathlib test mock

---
 readme_renderer/__main__.py |  4 ++--
 tests/test_cli.py           | 10 +++++-----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/readme_renderer/__main__.py b/readme_renderer/__main__.py
index a370fab..03f4343 100644
--- a/readme_renderer/__main__.py
+++ b/readme_renderer/__main__.py
@@ -41,7 +41,7 @@ def main(cli_args: Optional[List[str]] = None) -> None:
     else:
         filename = pathlib.Path(args.input)
         content_format = content_format or filename.suffix.lstrip(".")
-        with filename.open() as fp:
+        with filename.open(encoding="utf-8") as fp:
             source = fp.read()
 
     if content_format == "md":
@@ -58,7 +58,7 @@ def main(cli_args: Optional[List[str]] = None) -> None:
     if args.output == "-":
         print(rendered, file=sys.stdout)
     else:
-        with open(args.output, "w") as fp:
+        with open(args.output, "w", encoding="utf-8") as fp:
             print(rendered, file=fp)
 
 
diff --git a/tests/test_cli.py b/tests/test_cli.py
index dddf5c3..0ebde8b 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -22,7 +22,7 @@ def test_cli_input_file(input_file, output_file):
             with tempfile.TemporaryDirectory() as tmpdir:
                 output = pathlib.Path(tmpdir) / "output.html"
                 main(["-o", str(output), str(input_file)])
-                with output.open() as fp:
+                with output.open(encoding="utf-8") as fp:
                     result = fp.read()
         else:
             main([str(input_file)])
@@ -30,7 +30,7 @@ def test_cli_input_file(input_file, output_file):
     print_.assert_called_once()
     (result,), kwargs = print_.call_args
 
-    with input_file.with_suffix(".html").open() as fp:
+    with input_file.with_suffix(".html").open(encoding="utf-8") as fp:
         expected = fp.read()
     assert result.strip() == expected.strip()
 
@@ -46,14 +46,14 @@ def test_cli_invalid_format():
 
 def test_cli_explicit_format(input_file):
     fmt = input_file.suffix.lstrip(".")
-    with input_file.open() as fp, \
-            mock.patch("pathlib.Path.open", return_value=fp), \
+    with mock.patch("readme_renderer.__main__.pathlib") as pathlib_, \
             mock.patch("builtins.print") as print_:
+        pathlib_.Path.return_value = input_file
         main(["-f", fmt, "no-file.invalid"])
         print_.assert_called_once()
         (result,), _ = print_.call_args
 
-    with input_file.with_suffix(".html").open() as fp:
+    with input_file.with_suffix(".html").open(encoding="utf-8") as fp:
         assert result.strip() == fp.read().strip()
 
 
-- 
